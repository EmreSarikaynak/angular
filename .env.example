# ── Supabase ────────────────────────────────────────────────────────────────
# Supabase › Project Settings › API
NEXT_PUBLIC_SUPABASE_URL=https://PROJE-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# GİZLİ: yalnızca sunucuda kullanılır, asla NEXT_PUBLIC_ öneki vermeyin.
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Gemini ───────────────────────────────────────────────────────────
# GİZLİ: https://aistudio.google.com/apikey — yalnızca sunucuda okunur.
GEMINI_API_KEY=
# İsteğe bağlı: varsayılan model (yönetim panelinden de değiştirilebilir).
GEMINI_MODEL=gemini-3.8-flash
# İsteğe bağlı: yalnızca test/proxy için API taban adresi.
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com

# ── Yönetim ─────────────────────────────────────────────────────────────────
# Virgülle ayrılmış, e-postası doğrulanmış yönetici hesapları.
ADMIN_EMAILS=

# ── Bildirimler (Web Push) — isteğe bağlı ───────────────────────────────────
# Anahtar üretmek için: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:siz@example.com
# Zamanlayıcının /api/cron/reminders ucunu çağırırken kullandığı gizli anahtar.
CRON_SECRET=

# ── Gizlilik sayfası — isteğe bağlı ─────────────────────────────────────────
NEXT_PUBLIC_DATA_CONTROLLER=
NEXT_PUBLIC_PRIVACY_CONTACT=
