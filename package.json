{
  "name": "besin-takip",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "test:integration": "node --env-file=.env.local tests/integration/run.mjs",
    "test:e2e": "node --env-file=.env.local tests/e2e/run.cjs && node --env-file=.env.local tests/e2e/offline.cjs && node --env-file=.env.local tests/e2e/dietitian.cjs && node --env-file=.env.local tests/e2e/native.cjs",
    "mock:gemini": "node scripts/mock-gemini.mjs",
    "i18n:check": "node scripts/i18n-extract.mjs",
    "cap:assets": "capacitor-assets generate --iconBackgroundColor '#1f9d76' --iconBackgroundColorDark '#1f9d76' --splashBackgroundColor '#1f9d76' --splashBackgroundColorDark '#0f1513'",
    "cap:sync": "cap sync",
    "cap:ios": "cap sync ios && cap open ios",
    "cap:android": "cap sync android && cap open android",
    "cap:run:ios": "cap run ios",
    "cap:run:android": "cap run android",
    "cap:doctor": "cap doctor"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@supabase/supabase-js": "^2.119.2",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.11.0",
    "server-only": "^0.0.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
